      "pluginVersion": "9.5.0",
      "targets": [
        {
          "alias": "",
          "bucketAggs": [
            { "field": "@timestamp", "id": "1", "settings": { "interval": "auto", "min_doc_count": 0, "trimEdges": 0 }, "type": "date_histogram" }
          ],
          "datasource": { "type": "elasticsearch", "uid": "${DS_ELASTICSEARCH}" },
          "metrics": [
            { "field": "@timestamp", "id": "1", "meta": {}, "settings": {}, "type": "count" }
          ],
          "query": "service:$service AND level:(error OR critical)",
          "refId": "A",
          "timeField": "@timestamp"
        }
      ],
      "title": "Recent Log Errors",
