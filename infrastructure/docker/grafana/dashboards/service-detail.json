        { "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" }, "expr": "avg(rate(container_cpu_usage_seconds_total{container_label_com_docker_compose_service=\"$service\"}[5m])) by (container_label_com_docker_compose_service) * 100", "legendFormat": "CPU %", "refId": "A" }
