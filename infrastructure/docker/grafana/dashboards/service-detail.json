      "targets": [
        { "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" }, "expr": "container_memory_usage_bytes{container_label_com_docker_compose_service=\"$service\"}", "legendFormat": "Memory Usage", "refId": "A" }
      ],
      "title": "Memory Usage",
      "type": "timeseries"
