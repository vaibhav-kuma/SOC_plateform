        "overrides": [
          { "matcher": { "id": "byName", "options": "@timestamp" }, "properties": [{ "id": "custom.width", "value": 200 }, { "id": "displayName", "value": "Timestamp" }] },
          { "matcher": { "id": "byName", "options": "level" }, "properties": [{ "id": "custom.width", "value": 80 }] },
          { "matcher": { "id": "byName", "options": "message" }, "properties": [{ "id": "custom.width", "value": 600 }] },
          { "matcher": { "id": "byName", "options": "service" }, "properties": [{ "id": "custom.width", "value": 150 }] }
